# Leonardo refresher sidecar 部署配置（复制为 .env，勿提交）
# 用法：docker compose --profile leonardo up -d --build

# --- 推送鉴权：adobe2api 与 refresher 必须同值（不设则专用端点返回 503）---
# 生成：openssl rand -hex 32
LEONARDO_REFRESH_KEY=

# --- 代理 ---
# 搬瓦工若在非受限地区（US/JP/NL 等），可留空＝直连 Leonardo（推荐，最简单）。
# 仅当出口被 Adobe/Leonardo 地理封锁时才填，例如 http://127.0.0.1:10809
LEONARDO_PROXY=

# --- token 最小有效期（秒）：与 refresher SAFETY_MARGIN 一致 ---
LEONARDO_TOKEN_MIN_TTL_SECONDS=600

# --- refresher 行为 ---
LEONARDO_ACCOUNT_LABEL=Leonardo
REFRESH_INTERVAL_SECONDS=3000
MIN_INTERVAL_SECONDS=60

# --- noVNC 远程登录（务必设强密码，≥8 字符）---
# 生成：openssl rand -base64 18
NOVNC_PASSWORD=
# noVNC 端口只绑 127.0.0.1，需 SSH 隧道访问（见部署文档）
LEONARDO_NOVNC_PORT=6080
